# --- Database (SMM-8 — User Database & Backend Connection) ---
DATABASE_URL="postgresql://postgres:12345@localhost:5432/smatch_db?schema=public"

# --- App ---
PORT=3000
NODE_ENV=development

# Generate distinct random secrets (at least 32 characters each) before starting.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-characters
JWT_ISSUER=s-match

# Full endpoint URL for the Python service; change host for Docker/deployment.
MATCHMAKING_API_URL=http://127.0.0.1:8000/api/v1/match
MATCHMAKING_TIMEOUT_MS=5000
