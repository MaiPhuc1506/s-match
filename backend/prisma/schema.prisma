// S-Match — Prisma Schema
// SMM-8 — User Database & Backend Connection (Sprint 1).
//
// Scope is intentionally limited to Auth-adjacent tables (Role, User).
// Other sprint tickets own their own tables and should add their models here
// as their own work, e.g.:
//   - SMM-6  Authentication Backend        -> may add refresh-token storage, etc.
//   - SMM-14/16 Court Management            -> CourtFacility, Court, TimeSlotTemplate, ...
//   - SMM-18/20 Court Booking                -> Booking, OpenMatch, ...
//   - SMM-10/12 Player & Community Profile   -> PlayerProfile, PlayingPreference, ...

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  COURT_OWNER
  PLAYER
}

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  password          String
  fullName          String?
  phone             String?
  roleId            Int
  role              Role               @relation(fields: [roleId], references: [id])
  playerProfile     PlayerProfile?
  playingPreference PlayingPreference?
  availabilities    Availability[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model PlayerProfile {
  id         Int     @id @default(autoincrement())
  userId     Int     @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname   String?
  avatarUrl  String?
  skillLevel String? @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  bio        String?
  gender     String?

  // SMM-12 / SMM-13: Bổ sung bảng Skill nối với PlayerProfile
  skill Skill?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bảng Skill mới được yêu cầu cho màn hình Radar Kỹ năng
model Skill {
  id              Int           @id @default(autoincrement())
  playerProfileId Int           @unique
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  smash           Float         @default(0)
  defense         Float         @default(0)
  netPlay         Float         @default(0)
  stamina         Float         @default(0)
  footwork        Float         @default(0)
  serve           Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum MatchMode {
  SINGLES
  DOUBLES
}

enum MatchPurpose {
  CASUAL
  TRAINING
  COMPETITIVE
}

model PlayingPreference {
  id            Int          @id @default(autoincrement())
  userId        Int          @unique
  user          User         @relation(fields: [userId], references: [id])
  preferredMode MatchMode    @default(DOUBLES)
  purpose       MatchPurpose @default(CASUAL)
  minSkillLevel Int
  maxSkillLevel Int
  maxDistanceKm Float        // Should probably be float or int. Let's keep Int based on original. Wait, the DTO says Int/Number.

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Availability {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayOfWeek, startTime])
}
