// S-Match — Prisma Schema
// SMM-8 — User Database & Backend Connection (Sprint 1).
//
// Scope is intentionally limited to Auth-adjacent tables (Role, User).
// Other sprint tickets own their own tables and should add their models here
// as their own work, e.g.:
//   - SMM-6  Authentication Backend        -> may add refresh-token storage, etc.
//   - SMM-14/16 Court Management            -> CourtFacility, Court, TimeSlotTemplate, ...
//   - SMM-18/20 Court Booking                -> Booking, OpenMatch, ...
//   - SMM-10/12 Player & Community Profile   -> PlayerProfile, PlayingPreference, ...

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  COURT_OWNER
  PLAYER
}

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  password          String
  fullName          String?
  phone             String?
  roleId            Int
  role              Role               @relation(fields: [roleId], references: [id])
  refreshSessions   RefreshSession[]
  playerProfile     PlayerProfile?
  playingPreference PlayingPreference?
  availabilities    Availability[]
  
  facilities        Facility[]
  bookings          Booking[]
  hostedMatches      Match[]            @relation("HostedMatches")
  matchParticipants  MatchParticipant[]
  sentFeedback       Feedback[]         @relation("FeedbackSender")
  receivedFeedback   Feedback[]         @relation("FeedbackRecipient")

  // SMM-32 — Recommendation History Backend
  recommendationSessions RecommendationSession[]
  recommendedInResults   RecommendationResult[]  @relation("RecommendedUser")

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model RefreshSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  refreshTokenHash String    @db.Char(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model PlayerProfile {
  id         Int     @id @default(autoincrement())
  userId     Int     @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname   String?
  avatarUrl  String?
  skillLevel String? @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  bio        String?
  gender     String?

  // SMM-28 — Candidate Data & Geo Search: vị trí gần nhất của người chơi
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime?

  // SMM-12 / SMM-13: Bổ sung bảng Skill nối với PlayerProfile
  skill Skill?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
}

// Bảng Skill mới được yêu cầu cho màn hình Radar Kỹ năng
model Skill {
  id              Int           @id @default(autoincrement())
  playerProfileId Int           @unique
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  smash           Float         @default(0)
  defense         Float         @default(0)
  netPlay         Float         @default(0)
  stamina         Float         @default(0)
  footwork        Float         @default(0)
  serve           Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum MatchMode {
  SINGLES
  DOUBLES
}

enum MatchPurpose {
  CASUAL
  TRAINING
  COMPETITIVE
}

model PlayingPreference {
  id            Int          @id @default(autoincrement())
  userId        Int          @unique
  user          User         @relation(fields: [userId], references: [id])
  preferredMode MatchMode    @default(DOUBLES)
  purpose       MatchPurpose @default(CASUAL)
  minSkillLevel Int
  maxSkillLevel Int
  maxDistanceKm Float        // Should probably be float or int. Let's keep Int based on original. Wait, the DTO says Int/Number.

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Availability {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayOfWeek, startTime])
}
enum CourtStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}
model Facility {
  id             Int              @id @default(autoincrement())
  ownerId        Int
  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  address        String
  latitude       Float?
  longitude      Float?
  contactPhone   String?
  description    String?
  courts         Court[]
  operatingHours OperatingHours[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}
model Court {
  id         Int         @id @default(autoincrement())
  facilityId Int
  facility   Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name       String      // Ví dụ: Sân 1, Sân 2, Sân VIP
  courtType  String?     @default("INDOOR") // INDOOR, OUTDOOR
  status     CourtStatus @default(ACTIVE)
  timeSlots  TimeSlot[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  bookings   Booking[]
}
// SMM-20 — Slot & Pricing Backend (Sprint 4).
// Khung giờ định kỳ hàng tuần của một sân, kèm giá cho khung giờ đó.
model TimeSlot {
  id        Int      @id @default(autoincrement())
  courtId   Int
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0: Chủ Nhật, 1: Thứ 2, ..., 6: Thứ 7
  startTime String   // "18:00"
  endTime   String   // "19:00"
  price     Float    // Giá cho khung giờ này (VNĐ)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courtId, dayOfWeek, startTime])
  @@index([courtId])
}
model OperatingHours {
  id         Int      @id @default(autoincrement())
  facilityId Int
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0: Chủ Nhật, 1: Thứ 2, ..., 6: Thứ 7
  openTime   String   // Ví dụ: "06:00"
  closeTime  String   // Ví dụ: "22:00"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([facilityId, dayOfWeek])
}
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
model Booking {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courtId     Int
  court       Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)

  startTime   DateTime
  endTime     DateTime
  totalPrice  Float         @default(0)
  status      BookingStatus @default(CONFIRMED)
  note        String?
  match              Match?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([courtId, startTime, endTime])
  @@index([userId])
}

//Match Management Models & Enums
enum MatchPrivacy {
  PRIVATE
  OPEN
}

enum MatchState {
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ParticipantRole {
  HOST
  MEMBER
}

enum ParticipantStatus {
  INVITED     // Host gửi lời mời -> Chờ người chơi Accept / Reject
  REQUESTED   // Người chơi gửi yêu cầu xin vào Open Match -> Chờ Host Approve / Reject
  ACCEPTED    // Đã chính thức tham gia trận
  REJECTED    // Bị từ chối hoặc người chơi từ chối lời mời
  CANCELLED   // Đã rời trận hoặc hủy yêu cầu
}

model Match {
  id           Int                @id @default(autoincrement())
  title        String
  description  String?
  privacy      MatchPrivacy       @default(OPEN)
  status       MatchState         @default(OPEN)
  mode         MatchMode          @default(DOUBLES)
  purpose      MatchPurpose       @default(CASUAL)
  minSkillLevel Int               @default(1)
  maxSkillLevel Int               @default(5)

  hostId       Int
  host         User               @relation("HostedMatches", fields: [hostId], references: [id], onDelete: Cascade)

  bookingId    Int?               @unique
  booking      Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  startTime    DateTime
  endTime      DateTime
  location     String?            // Địa chỉ sân hoặc tên sân (nếu không gắn booking cụ thể)
  maxPlayers   Int                @default(4)
  feePerPlayer Float?             @default(0)

  participants MatchParticipant[]
  feedbacks    Feedback[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([hostId])
  @@index([status])
  @@index([startTime])
}

model MatchParticipant {
  id        Int               @id @default(autoincrement())
  matchId   Int
  match     Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)

  userId    Int
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      ParticipantRole   @default(MEMBER)
  status    ParticipantStatus @default(REQUESTED)

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([matchId, userId])
  @@index([userId])
  @@index([status])
}

// SMM-34 / SMM-36 shared raw feedback. Aggregation/history are separate concerns.
model Feedback {
  id              Int      @id @default(autoincrement())
  matchId         Int
  match           Match    @relation(fields: [matchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  senderUserId    Int
  sender          User     @relation("FeedbackSender", fields: [senderUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipientUserId Int
  recipient       User     @relation("FeedbackRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rating          Int
  comment         String?
  createdAt       DateTime @default(now())

  @@unique([matchId, senderUserId, recipientUserId])
  @@index([recipientUserId, createdAt])
}

// ---------------------------------------------------------------------------
// SMM-32 — Recommendation History Backend (Sprint 7 — Match Recommendation)
//
// Mỗi lần người chơi tìm đối thủ (Find Player) tạo một RecommendationSession,
// gồm snapshot tiêu chí tìm kiếm và danh sách Top-K kết quả đã gợi ý
// (RecommendationResult). Dùng để xem lại lịch sử gợi ý và đo hiệu quả
// Matchmaking (tỉ lệ mời / tỉ lệ chấp nhận, điểm tương thích trung bình).
// Việc ghi lịch sử do service nội bộ thực hiện (RecommendationHistoryService.
// recordSession), client không tự ghi để tránh giả mạo dữ liệu.
// ---------------------------------------------------------------------------

enum RecommendationOutcome {
  SHOWN     // Đã hiển thị cho người tìm
  INVITED   // Người tìm đã gửi lời mời / chọn người này
  ACCEPTED  // Người được gợi ý đã chấp nhận -> ghép thành công
  DISMISSED // Người tìm bỏ qua
}

model RecommendationSession {
  id                       Int                    @id @default(autoincrement())
  userId                   Int
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  criteria                 Json?                  // Snapshot tiêu chí tìm kiếm tại thời điểm gọi
  totalCandidatesProcessed Int                    @default(0)
  results                  RecommendationResult[]
  createdAt                DateTime               @default(now())

  @@index([userId, createdAt])
}

model RecommendationResult {
  id                Int                   @id @default(autoincrement())
  sessionId         Int
  session           RecommendationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recommendedUserId Int
  recommendedUser   User                  @relation("RecommendedUser", fields: [recommendedUserId], references: [id], onDelete: Cascade)
  rank              Int                   // 1 = gợi ý tốt nhất
  matchScore        Float
  breakdown         Json?                 // Điểm thành phần (skill/time/distance/style/reliability), nếu có
  outcome           RecommendationOutcome @default(SHOWN)
  outcomeUpdatedAt  DateTime?
  createdAt         DateTime              @default(now())

  @@unique([sessionId, recommendedUserId])
  @@index([sessionId])
  @@index([recommendedUserId])
  @@index([outcome])
}
